{
  "name": "arc-restaurant",
  "version": "1.0.0",
  "description": "Arc Nexus Store — Soroban-powered restaurant payments on Stellar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "contract:build": "cd contracts/restaurant && cargo build --target wasm32-unknown-unknown --release",
    "contract:test": "cd contracts/restaurant && cargo test",
    "contract:deploy": "node scripts/deploy-contract.mjs"
  },
  "keywords": [
    "stellar",
    "soroban",
    "restaurant",
    "payments",
    "blockchain",
    "dapp"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "@stellar/freighter-api": "^4.1.0",
    "@stellar/stellar-sdk": "^13.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
