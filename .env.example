# Stellar Network Configuration
VITE_NETWORK=TESTNET
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Smart Contract (RestaurantContract, deployed from contracts/restaurant)
VITE_CONTRACT_ID=
# Native XLM Stellar Asset Contract used for `pay` — defaults to the testnet SAC if unset
VITE_TOKEN_ADDRESS=

# Monitoring & Analytics
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=

# App Configuration
VITE_APP_NAME=Arc Nexus Store
VITE_APP_DESCRIPTION=Soroban-powered restaurant payments on Stellar
VITE_APP_URL=http://localhost:3000

# API Configuration
VITE_API_TIMEOUT=10000
